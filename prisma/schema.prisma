// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          String   @id @default(uuid())
  title       String   @default("Untitled Event") @db.VarChar(400)
  description String?  @db.VarChar(1000)
  slug        String   @unique @db.VarChar(800)
  overview    String?  @db.Text
  image       String?
  venue       String   @db.VarChar(200)
  location    String   @db.VarChar(300)
  date        DateTime
  mode        Mode     @default(OFFLINE)
  audience    String   @db.Text
  agendas     String[]
  organizers  String
  tags        Tags[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Mode {
  HYBRID
  ONLINE
  OFFLINE
}

model Tags {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  events Event[]

  @@index(name)
}
